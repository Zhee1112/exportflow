# ExportFlow environment template — copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# ---- Frontend (NEXT_PUBLIC_* are inlined into the browser bundle) ----
# Networks the app offers, comma separated, first is default: aevum,fork,local
NEXT_PUBLIC_NETWORKS=aevum

# ExportFlow contracts (see README "Deployed contracts" for the Aevum addresses)
NEXT_PUBLIC_ESCROW_AEVUM=
NEXT_PUBLIC_SESSION_POLICY_AEVUM=
NEXT_PUBLIC_DOC_REGISTRY_AEVUM=
# First block to scan events from (the Escrow deploy block)
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=

NEXT_PUBLIC_ESCROW_FORK=
NEXT_PUBLIC_SESSION_POLICY_FORK=
NEXT_PUBLIC_DOC_REGISTRY_FORK=

NEXT_PUBLIC_ESCROW_LOCAL=
NEXT_PUBLIC_SESSION_POLICY_LOCAL=
NEXT_PUBLIC_DOC_REGISTRY_LOCAL=

# Optional: WalletConnect project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: point the "Source" links at your own repo
NEXT_PUBLIC_REPO_URL=

# ---- Server-only secrets. Never expose these in the browser. ----
# Relayer that submits EIP-3009 gasless transactions (pays tQDAY). Testnet only.
RELAYER_PRIVATE_KEY=
RELAYER_DAILY_TX_LIMIT=500
# Which header your proxy sets with the real client IP (Vercel: x-vercel-forwarded-for)
TRUSTED_IP_HEADER=

# Seller agent (demo counterparty) that signs submitEvidence / claimAfterDeadline.
# Testnet only: this is a throwaway key holding test tokens.
RINA_PRIVATE_KEY=

# Optional: model API for the PO reader. Without it the built-in deterministic parser is used.
AI_API_KEY=
AI_MODEL=
